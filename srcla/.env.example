# Blockchain
BASE_RPC_URL=http://127.0.0.1:8545

# Contracts (Base deployment)
VAULT_ADDRESS=0x...
AAVE_STRATEGY_ADDRESS=0x...
COMPOUND_STRATEGY_ADDRESS=0x...
MOONWELL_STRATEGY_ADDRESS=0x...
REWARD_ACCOUNTANT_ADDRESS=0x...
REWARD_EXECUTOR_ADDRESS=0x...

# USDC (Circle Base USDC)
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Database
DATABASE_URL=postgresql://user:password@localhost:5433/srcla

# HTTP Server
HTTP_HOST=0.0.0.0
HTTP_PORT=3100

# Scheduler
COLLECTOR_ENABLED=true
COLLECTOR_INTERVAL_MS=900000
CONTROLLER_ENABLED=true
CONTROLLER_INTERVAL_MS=3600000


# SRCLA Configuration
SRCLA_RESERVE_FLOOR_BPS=500
SRCLA_RESERVE_QUANTILE=0.95
SRCLA_COST_GATE_MIN_THRESHOLD=1
SRCLA_COST_GATE_SLIPPAGE_BPS=50
SRCLA_COST_GATE_MEV_BPS=10
SRCLA_COLD_START_PERIOD_DAYS=7
SRCLA_MIN_FORECAST_COVERAGE=0.95

# Gas/price oracle placeholders (Task 13). GasObservation needs
# l2BaseFeeWei, l1BaseFeeWei, l1BlobBaseFeeWei, ethUsdE8 and usdcUsdE8;
# l2BaseFeeWei is read live off the L2 RPC, but there is no L1-base-fee,
# L1-blob-base-fee, ETH/USD or USDC/USD oracle wired into this service yet.
# These four are PLACEHOLDERS pending a real oracle - do not cite any
# cost-gate result computed with the defaults below.
SRCLA_PLACEHOLDER_L1_BASE_FEE_WEI=8000000000
SRCLA_PLACEHOLDER_L1_BLOB_BASE_FEE_WEI=10000000
SRCLA_PLACEHOLDER_ETH_USD_E8=350000000000
SRCLA_PLACEHOLDER_USDC_USD_E8=100000000
