# srcla service configuration.
#
# Every variable below is read by code in this package; nothing that is read
# is missing. The list was reconciled against `src/config.ts` and a grep for
# `process.env` across src/ and scripts/ on 2026-09-08 -- if you add a
# `process.env` read, add it here too.
#
# Values shown are the code's own defaults unless marked REQUIRED. A REQUIRED
# variable has no usable default: `loadConfig()` supplies '' and the zod
# schema then fails at boot.

# ─────────────────────────────────────────────────────────────
# Chain
# ─────────────────────────────────────────────────────────────

# JSON-RPC endpoint. Local development points this at an Anvil fork of Base
# mainnet; there is no testnet deployment. Also read directly by
# `execution/keeper-executor.ts#createKeeperExecutor`, which throws if unset.
BASE_RPC_URL=http://127.0.0.1:8545

# Expected chain id. 8453 = Base mainnet, which an Anvil fork of Base also
# reports. Feeds the EIP-712 plan domain (`policy/steps/plan.ts#planDomain`),
# so a wrong value produces plans the vault will not accept.
CHAIN_ID=8453

# ─────────────────────────────────────────────────────────────
# Contracts (REQUIRED -- these change on every local redeploy)
# ─────────────────────────────────────────────────────────────

VAULT_ADDRESS=0x...
AAVE_STRATEGY_ADDRESS=0x...
COMPOUND_STRATEGY_ADDRESS=0x...
MOONWELL_STRATEGY_ADDRESS=0x...
REWARD_EXECUTOR_ADDRESS=0x...

# Optional in the schema (`.optional()`); everything else above is required.
REWARD_ACCOUNTANT_ADDRESS=0x...

# Circle native Base USDC. Constant on Base and inherited by a Base fork.
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Keeper signing key, read directly by
# `execution/keeper-executor.ts#createKeeperExecutor` and
# `evaluation/proposal-evaluator.ts` (NOT via loadConfig). Both throw when it
# is unset, so leave it commented out until a keeper is actually wired --
# a placeholder here would be a malformed key, not a working one.
# KEEPER_PRIVATE_KEY=0x...

# ─────────────────────────────────────────────────────────────
# Database (REQUIRED)
# ─────────────────────────────────────────────────────────────

# srcla's own Postgres (docker-compose.yml, :5433).
DATABASE_URL=postgresql://user:password@localhost:5433/srcla

# ─────────────────────────────────────────────────────────────
# HTTP
# ─────────────────────────────────────────────────────────────

HTTP_HOST=0.0.0.0
HTTP_PORT=3100

# Loopback-only operator listener carrying the three mutation routes
# (POST /v1/manifests, /v1/proposals/review, /v1/internal/trigger).
# The host is fixed at 127.0.0.1 in code; only the port is configurable.
OPERATOR_HTTP_PORT=3101

# Fastify log level (`http/server.ts`). Default 'info'. The in-process
# `server.inject()` tests set 'silent'.
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────
# Scheduler
# ─────────────────────────────────────────────────────────────

# Any value other than the literal 'false' enables these.
COLLECTOR_ENABLED=true
CONTROLLER_ENABLED=true

# Snapshot collection cadence, ms. Schema minimum 60000.
COLLECTOR_INTERVAL_MS=900000

# Decision cycle cadence, ms. Schema minimum 60000.
CONTROLLER_INTERVAL_MS=3600000

# ─────────────────────────────────────────────────────────────
# Optimizer
# ─────────────────────────────────────────────────────────────

# Correlated-venue caps: a JSON array of
# {id, capBps, adapters: ["0x..."]} objects, where capBps is a JSON number
# coerced to bigint by the schema. Default is [] (no dependency groups).
# Malformed JSON logs a warning and falls back to [] rather than failing.
# DEPENDENCY_GROUPS=[{"id":"comp-family","capBps":4000,"adapters":["0x..."]}]

# ─────────────────────────────────────────────────────────────
# SRCLA parameters
# ─────────────────────────────────────────────────────────────
#
# ONLY the proposal-review path is configured from the environment. The
# decision kernel's own parameters live in `policy/decide.ts`'s
# DEFAULT_DECIDE_OPTS and in the policy artifact
# (config/bootstrap-artifact.json), because §10.2 requires a decision's
# parameters to be reconstructable from the hashed artifact -- an ambient env
# var is not. Twenty knobs that looked like kernel parameters but were parsed
# into fields no code read were deleted on 2026-09-08; see the scope comment
# on SrclaConfigSchema in src/config.ts before adding one back.
#
# These four are read by `evaluation/proposal-evaluator.ts`, which reviews an
# externally supplied rebalance proposal (POST /v1/proposals/review).

# Reserve floor, basis points of total assets (§8.1).
SRCLA_RESERVE_FLOOR_BPS=500

# Cost gate (§9.1). MIN_THRESHOLD is in USDC BASE UNITS (6 dp), so the
# default of 1 is 0.000001 USDC, not 1 USDC.
SRCLA_COST_GATE_MIN_THRESHOLD=1
SRCLA_COST_GATE_SLIPPAGE_BPS=50
SRCLA_COST_GATE_MEV_BPS=10
SRCLA_COST_GATE_GAS_LIMIT=200000

# ─────────────────────────────────────────────────────────────
# Gas/price oracle inputs (Task 13)
# ─────────────────────────────────────────────────────────────
#
# GasObservation needs l2BaseFeeWei, l1BaseFeeWei, l1BlobBaseFeeWei, ethUsdE8
# and usdcUsdE8; l2BaseFeeWei is read live off the L2 RPC, but there is no
# L1-base-fee, L1-blob-base-fee, ETH/USD or USDC/USD oracle wired into this
# service yet, so the other four run on hardcoded placeholder constants by
# default.
#
# LEAVE THESE FOUR COMMENTED OUT. They are named SRCLA_REAL_* because
# SETTING one tells the service "a genuine, oracle-sourced value has been
# supplied" -- computePlaceholderPriceStatus (src/config.ts) derives
# placeholderPricesInUse from whether these are set, and the Task-13
# execution guard (assertExecutionAllowed) refuses to hand a plan to any
# executor while placeholderPricesInUse is true. Uncommenting one of these
# with a fabricated number (as this file used to do under the old
# SRCLA_PLACEHOLDER_* names) DISENGAGES that guard while the price is still
# made up. Only uncomment a line below once it is wired to a real oracle
# feed, and do not cite any cost-gate result computed while any of these
# stay commented out.
# SRCLA_REAL_L1_BASE_FEE_WEI=8000000000
# SRCLA_REAL_L1_BLOB_BASE_FEE_WEI=10000000
# SRCLA_REAL_ETH_USD_E8=350000000000
# SRCLA_REAL_USDC_USD_E8=100000000

# ─────────────────────────────────────────────────────────────
# Evaluation provenance
# ─────────────────────────────────────────────────────────────

# Overrides the code commit recorded in an evaluation manifest
# (`evaluation/manifest/manifest.ts`, `evaluation/kernel/provenance.ts`,
# scripts/run-registered-evaluation.ts, scripts/verify-evaluation.ts).
# Leave unset when running inside the git worktree -- the scripts read
# `git rev-parse HEAD`. Set it only where git is unavailable; manifest.ts
# falls back to the literal 'unknown', which provenance verification
# rejects.
# GIT_COMMIT_HASH=

# Opt-in for the quarantined evaluation reimplementations under
# `src/evaluation/quarantined/` (`assertQuarantineOptIn`). Those modules do
# not call src/policy/decide.ts, so their numbers are not measurements of the
# SRCLA policy -- they are kept only to reproduce previously published
# figures. MUST stay unset for any real run; `pnpm test:quarantined` and
# `pnpm evaluation:quarantined` set it themselves.
# SRCLA_ALLOW_QUARANTINED_HARNESS=1

# ─────────────────────────────────────────────────────────────
# Read only by scripts/, never by the service
# ─────────────────────────────────────────────────────────────
#
# Listed for completeness so a `grep process.env` never turns up a variable
# this file does not mention. None of these are read by src/.

# scripts/anvil-fork-test.ts
# ANVIL_RPC_URL=http://127.0.0.1:8545
# NAVY_VAULT_ADDRESS=0x...
# AAVE_ADAPTER_ADDRESS=0x...
# COMPOUND_ADAPTER_ADDRESS=0x...
# MOONWELL_ADAPTER_ADDRESS=0x...
# DEPLOYER_PRIVATE_KEY=0x...     # defaults to Anvil account 0
# ALLOCATOR_PRIVATE_KEY=0x...    # defaults to Anvil account 1

# scripts/probe-emissions.ts
# RPC_URL=                       # fallback when BASE_RPC_URL is unset
# COMET_REWARDS_ADDRESS=0x...    # optional; probe reports without it

# scripts/phase1-fork-check.ts
# GIT_COMMIT=                    # defaults to 'phase1-fork-check'
