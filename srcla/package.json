{
  "name": "@navy/srcla",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest test/unit test/integration --runInBand",
    "test:unit": "NODE_OPTIONS='--experimental-vm-modules' jest test/unit --runInBand",
    "test:integration": "NODE_OPTIONS='--experimental-vm-modules' jest test/integration --runInBand",
    "test:eval": "NODE_OPTIONS='--experimental-vm-modules' jest test/evaluation --runInBand",
    "test:all": "NODE_OPTIONS='--experimental-vm-modules' jest test/ --runInBand",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --runInBand --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "collect": "tsx scripts/collect-once.ts",
    "collect:scheduled": "tsx scripts/collect-scheduled.ts",
    "collect:scheduled:daemon": "tsx scripts/collect-scheduled.ts --no-immediate",
    "evaluation:run": "tsx scripts/run-evaluation.ts",
    "evaluation:synthetic": "tsx scripts/run-evaluation.ts --synthetic",
    "evaluation:full": "tsx scripts/run-evaluation-full.ts",
    "anvil:test": "tsx scripts/anvil-fork-test.ts",
    "cli": "tsx src/cli/index.ts",
    "cli:collect": "tsx src/cli/index.ts collect",
    "cli:evaluate": "tsx src/cli/index.ts evaluate",
    "cli:regime": "tsx src/cli/index.ts regime",
    "cli:health": "tsx src/cli/index.ts health"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@prisma/client": "^5.19.0",
    "dotenv": "^17.4.2",
    "ethers": "^6.13.2",
    "fastify": "^4.28.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.5.4",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "prisma": "^5.19.0",
    "ts-jest": "^29.4.12",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
