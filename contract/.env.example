# JSON-RPC endpoint for Base (Mainnet / local Anvil fork)
BASE_RPC_URL=http://127.0.0.1:8545
# Etherscan / Basescan API key for verification (optional)
ETHERSCAN_API_KEY=
# Deployer EOA private key (funds deploy; can equal the owner)
DEPLOYER_PRIVATE_KEY=
# Circle Base USDC (EIP-3009 + EIP-2612)
NAVY_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Fee sink + admin owner + initial relayer
NAVY_TREASURY_ADDRESS=
NAVY_OWNER_ADDRESS=
NAVY_RELAYER_ADDRESS=
# Fee in basis points (100 = 1%)
NAVY_FEE_BPS=100
