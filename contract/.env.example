# JSON-RPC endpoint for Base (Mainnet / local Anvil fork)
BASE_RPC_URL=http://127.0.0.1:8545
# Etherscan / Basescan API key for verification (optional)
ETHERSCAN_API_KEY=
# Circle Base USDC, read by script/DeployNavyVaultSRCLA.s.sol
NAVY_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Deployer key read by DeployNavyVaultSRCLA.s.sol (that script reads PRIVATE_KEY,
# not DEPLOYER_PRIVATE_KEY - set both to the same key)
PRIVATE_KEY=
# Deployer EOA private key read by script/DeployBaseSystem.s.sol
DEPLOYER_PRIVATE_KEY=
# Vault + roles for the Base package (script/DeployBaseSystem.s.sol);
# BASE_ADMIN_ADDRESS and BASE_ALLOCATOR_ADDRESS must differ
BASE_ADMIN_ADDRESS=
BASE_ALLOCATOR_ADDRESS=
# Deployed NavyVaultSRCLA, read by script/ConfigureAnvil.s.sol
VAULT_ADDRESS=
# Optional: pin the Base fork block for the fork tests (defaults to each suite's PINNED_BLOCK)
BASE_FORK_BLOCK=
