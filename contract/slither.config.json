{
  "filter_paths": [
    "lib/",
    "node_modules/",
    "test/",
    "script/"
  ],
  "exclude_informational": false,
  "exclude_low": false,
  "exclude_medium": false,
  "exclude_high": false,
  "solc_remaps": [
    "@openzeppelin/contracts/=lib/openzeppelin-contracts/contracts/",
    "@chainlink/contracts/=lib/chainlink-brownie-contracts/contracts/"
  ],
  "compile_force_framework": "foundry",
  "foundry_ignore_compile_errors": true,
  "detectors_to_run": [
    "arbitrary-send-erc20",
    "arbitrary-send-eth",
    "controlled-array-length",
    "controlled-delegatecall",
    "delegatecall-loop",
    "domain-separator-collision",
    "erc20-interface",
    "erc721-interface",
    "events-access-control",
    "events-opacity",
    "exposed-functions",
    "external-function",
    "function-init-state",
    "governance-token",
    "hash-collision",
    "immutable-order",
    "incorrect-equality",
    "initiate-control-roles",
    "large-bytes-constant",
    "locked-ether",
    "low-level-calls",
    "mapping-deletion",
    "missing-calls",
    "missing-inheritance",
    "msg-value-loop",
    "multiple-constructors",
    "naming-convention",
    "non-reentrant-keccak",
    "openzeppelin-initializable",
    "pricing",
    "protect-priviliged-owner",
    "public-function-no-reentrancy-check",
    "reentrancy-eth",
    "reentrancy-no-eth",
    "reentrancy-unlimited-gas",
    "rtlo",
    "shadowing-state",
    "shift-parameter",
    "silently-accept-eth",
    "similar-name",
    "solc-version",
    "state-variable-default-Visibility",
    "struct-initialization",
    "tautology",
    "tx-origin",
    "unchecked-access",
    "unchecked-lowlevel",
    "unchecked-transfer",
    "unimplemented-functions",
    "uninitialized-state-variables",
    "unnecessary-upgradeable-check",
    "unused-return",
    "unused-state-variable",
    "variable-scope",
    "write-after-write"
  ],
  "check_version": "0.10.0"
}
