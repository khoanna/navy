{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SRCLA Dataset Manifest",
  "type": "object",
  "required": ["schemaVersion", "chainId", "registryHash", "startBlock", "endBlock", "markets", "files", "createdAt"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "chainId": {"const": 8453},
    "registryHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "startBlock": {"type": "integer", "minimum": 1},
    "endBlock": {"type": "integer", "minimum": 1},
    "markets": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "rpcEvidence": {"type": "object", "additionalProperties": {"type": "string"}},
    "files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "rows"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "rows": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "createdAt": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
