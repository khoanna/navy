# NOTE: the app reads config from app.json -> "extra" (via Constants.expoConfig.extra),
# NOT from this .env file. These values document what must be set; mirror them into
# app.json "extra" (camelCase keys) for the app to pick them up.
#
#   .env key          ->  app.json extra key
#   PRIVY_APP_ID      ->  privyAppId
#   PRIVY_CLIENT_ID   ->  privyClientId
#   NAVY_API_URL      ->  navyApiUrl
#   SOLANA_RPC        ->  solanaRpc
#   USDC_MINT         ->  usdcMint

PRIVY_APP_ID=replace_me
PRIVY_CLIENT_ID=replace_me
NAVY_API_URL=http://localhost:3000
SOLANA_RPC=https://api.devnet.solana.com
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
