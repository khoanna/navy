generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String    @id @default(uuid())
  privyDid                String    @unique
  primaryWallet           String?
  username                String?   @unique
  status                  String    @default("active")
  createdAt               DateTime  @default(now())
}

model Merchant {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String
  businessName   String
  approvalStatus        String    @default("pending")
  payoutAddress         String?
  createdAt             DateTime  @default(now())
  onchainRegisteredAt   DateTime?
  onchainRegisterTx     String?
  onchainMerchantId     String?   @unique
  rejectionReason       String?
  apiKeys               MerchantApiKey[]
  orders                Order[]
  products              Product[]
  chargeSettings        MerchantCharge[]
}

model MerchantApiKey {
  id             String   @id @default(uuid())
  merchantId     String
  merchant       Merchant @relation(fields: [merchantId], references: [id])
  apiKey         String   @unique
  secretHash     String
  status         String   @default("active")
  createdAt      DateTime @default(now())
  secretEnc      String?
  dataKeyWrapped String?
}

model Admin {
  id              String @id @default(uuid())
  email           String @unique
  passwordHash    String
  totpSecret      String
  failedTotpCount Int    @default(0)
  lastTotpStep        Int?
  lockedUntil         DateTime?
  failedPasswordCount Int       @default(0)
}

model AuthSession {
  id               String   @id @default(uuid())
  subjectId        String
  role             String
  refreshTokenHash String
  walletAddress    String?
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  revokedAt        DateTime?
}

model AuditLog {
  id        String   @id @default(uuid())
  actor     String
  action    String
  target    String?
  metadata  Json?
  createdAt DateTime @default(now())
}

model Order {
  id               String   @id @default(uuid())
  merchantId       String
  merchant         Merchant @relation(fields: [merchantId], references: [id])
  reference        String
  subtotal         BigInt?
  description      String?
  amount           BigInt
  feeBps           Int
  status           String   @default("created")
  onchainInvoiceId String
  txSignature      String?
  payer            String?
  callbackUrl      String?
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  paidAt           DateTime?
  issuedTxHash       String?
  issuedTxExpiresAt  DateTime?
  issuedTxConsumedAt DateTime?
  webhooks         WebhookDelivery[]
  items            OrderItem[]
  charges          OrderCharge[]
}

model WebhookDelivery {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  url         String
  status      String   @default("pending")
  attempts    Int      @default(0)
  lastError   String?
  deliveredAt DateTime?
  createdAt   DateTime @default(now())
}

model PayoutChallenge {
  id         String   @id @default(uuid())
  merchantId String
  nonce      String   @unique
  challenge  String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())
}

model Product {
  id            String   @id @default(uuid())
  merchantId    String
  merchant      Merchant @relation(fields: [merchantId], references: [id])
  name          String
  sku           String?
  unitPrice     BigInt
  imageUrl      String?
  imagePublicId String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MerchantCharge {
  id         String   @id @default(uuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  name       String
  mode       String
  value      Int
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String?
  name      String
  unitPrice BigInt
  quantity  Int
}

model OrderCharge {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])
  name    String
  mode    String
  value   Int
  amount  BigInt
}

model Transfer {
  id          String    @id @default(uuid())
  fromUserId  String
  fromAddress String
  toAddress   String
  toUsername  String?
  amount      BigInt
  asset       String    @default("USDC")
  nonce       String?   @unique // bytes32 EIP-3009 authorization nonce
  digest      String?   @unique // EIP-712 digest the wallet signs
  validBefore DateTime?
  status      String    @default("awaiting_signature") // awaiting_signature|confirming|confirmed|failed
  txHash      String?
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([fromUserId, createdAt])
  @@index([status])
}

model AgentConversation {
  id        String         @id @default(uuid())
  userId    String
  title     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  messages  AgentMessage[]

  @@index([userId, updatedAt])
}

model AgentMessage {
  id             String            @id @default(uuid())
  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // system|user|assistant|tool
  content        String?
  toolCalls      Json?
  toolCallId     String?
  seq            Int               @default(autoincrement())
  createdAt      DateTime          @default(now())

  @@index([conversationId, createdAt])
}

model VaultDeposit {
  id          String    @id @default(uuid())
  userId      String
  userAddress String
  assetsBase  BigInt
  nonce       String    @unique
  digest      String    @unique
  validBefore DateTime?
  status      String    @default("awaiting_signature")
  txHash      String?
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([status])
}

model VaultRedeem {
  id          String    @id @default(uuid())
  userId      String
  userAddress String
  sharesBase  BigInt
  digest      String    @unique
  deadline    DateTime?
  status      String    @default("awaiting_signature")
  txHash      String?
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([status])
}

model RebalanceEvent {
  id          String   @id @default(uuid())
  kind        String
  fromAdapter String?
  toAdapter   String?
  amountBase  BigInt   @default(0)
  aprFromE18  BigInt   @default(0)
  aprToE18    BigInt   @default(0)
  txHash      String?
  status      String   @default("confirming")
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

// Vault cohort-level accounting for tracking per-cohort profit/loss
model VaultCohort {
  id               String   @id @default(cuid())
  cohortAddress    String   @unique // EVM address representing the cohort
  name             String?
  totalDeposits    BigInt   @default(0)
  totalWithdrawals BigInt   @default(0)
  totalHarvests    BigInt   @default(0) // Cumulative profit harvested
  netPosition      BigInt   @default(0) // netPosition = deposits - withdrawals + harvests
  lastUpdated      DateTime @default(now())
  createdAt        DateTime @default(now())

  transactions     VaultTransaction[]

  @@index([cohortAddress])
}

model VaultTransaction {
  id           String      @id @default(cuid())
  cohortId     String
  cohort       VaultCohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  txHash       String      @unique
  type         String      // 'deposit' | 'withdraw' | 'harvest' | 'reallocation'
  amount       BigInt
  shares       BigInt?
  sender       String      // EVM address
  adapter      String?     // For reallocation/harvest events
  blockNumber  BigInt
  timestamp    DateTime    @default(now())
  createdAt    DateTime    @default(now())

  @@index([cohortId, createdAt])
  @@index([txHash])
  @@index([type])
}
